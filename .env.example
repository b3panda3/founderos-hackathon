# FounderOS Environment Variables
# Copy this to .env and fill in your values

# === API Key (REQUIRED for production mode) ===
# Get from: https://fireworks.ai — Click "API Keys" in dashboard
FIREWORKS_API_KEY=fw_your-fireworks-api-key-here

# === App Settings ===
# Set to "true" during development (zero API cost, mock responses)
# Set to "false" for production/demo (real API calls via Fireworks/AMD)
DEV_MODE=true

# === Hackathon Platform Injection ===
# These are INJECTED by the hackathon cloud instance automatically.
# Do NOT set them manually on the hackathon platform.
# For local development, they default to standard Fireworks values.
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# ALLOWED_MODELS=accounts/fireworks/models/glm-5p2,...

# === Model IDs (ALL on Fireworks AI running AMD GPUs) ===
# Verified at https://fireworks.ai/models
MODEL_STRATEGIST=accounts/fireworks/models/glm-5p2
MODEL_RESEARCHER=accounts/fireworks/models/llama-v3p1-70b-instruct
MODEL_WRITER=accounts/fireworks/models/mistral-large
MODEL_ANALYST=accounts/fireworks/models/qwen2p5-72b-instruct
MODEL_CODER=accounts/fireworks/models/deepseek-v4-pro
MODEL_COACH=accounts/fireworks/models/gemma-4-26b-a4b-it

# === Embedding Model ===
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# === AMD GPU Local Inference (Optional) ===
# Set to "true" to use local vLLM on AMD GPU instead of Fireworks API
# USE_LOCAL_GPU=false
# LOCAL_VLLM_URL=http://localhost:8080/v1

# === Database ===
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=founder_knowledge

# === Server ===
APP_HOST=0.0.0.0
APP_PORT=8000